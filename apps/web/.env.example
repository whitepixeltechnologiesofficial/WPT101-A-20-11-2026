# Copy to .env.local.
#
# The ONLY setting that decides which backend Web talks to (WEB-R1.0).
#
#   WEB-R1.0 mock (default):  http://localhost:4010
#       start it with:  pnpm --filter @wpt/api-client mock
#       act as the phone at:  http://localhost:4010/__mock
#
#   Real backend (BE-6.1):    http://localhost:4000
#       start it with:  pnpm --filter @wpt/backend dev
#
# Nothing else in apps/web changes between the two.
API_BASE_URL=http://localhost:4010
